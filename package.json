{
  "name": "firebase-hooks-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Timonwa Akintokun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timonwa/firebase-hooks.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "pnpm --filter @timonwa/firebase-hooks build",
    "dev": "pnpm --filter @timonwa/firebase-hooks dev",
    "test": "pnpm --filter @timonwa/firebase-hooks test",
    "test:watch": "pnpm --filter @timonwa/firebase-hooks test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && prettier --check \"**/*.md\" && pnpm --filter docs lint",
    "lint:fix": "biome check --write . && prettier --write \"**/*.md\" && pnpm --filter docs lint:fix",
    "check:exports": "pnpm --filter @timonwa/firebase-hooks check:exports",
    "check:publish": "pnpm --filter @timonwa/firebase-hooks check:publish",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:publish && pnpm check:exports",
    "prerelease:readme": "cp README.md packages/firebase-hooks/README.md",
    "release": "pnpm prerelease:readme && pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx,mdx,json,css}": "prettier --write --ignore-unknown",
    "packages/**/*.{ts,tsx,json}": "biome check --write --no-errors-on-unmatched",
    "*.{ts,json}": "biome check --write --no-errors-on-unmatched",
    "**/*.md": "prettier --write"
  }
}
